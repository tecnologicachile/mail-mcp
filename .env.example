# mail-imap-mcp-rs example environment
# Copy to .env and replace placeholder values.

# --- Required: default account ---
MAIL_IMAP_DEFAULT_HOST=imap.example.com
MAIL_IMAP_DEFAULT_USER=your-email@example.com
MAIL_IMAP_DEFAULT_PASS=replace-with-app-password

# --- Optional per-account settings (defaults shown) ---
MAIL_IMAP_DEFAULT_PORT=993
MAIL_IMAP_DEFAULT_SECURE=true

# --- Optional additional accounts ---
# MAIL_IMAP_WORK_HOST=outlook.office365.com
# MAIL_IMAP_WORK_USER=user@company.com
# MAIL_IMAP_WORK_PASS=replace-with-work-password
# MAIL_IMAP_WORK_PORT=993
# MAIL_IMAP_WORK_SECURE=true

# MAIL_IMAP_PERSONAL_HOST=imap.fastmail.com
# MAIL_IMAP_PERSONAL_USER=user@fastmail.com
# MAIL_IMAP_PERSONAL_PASS=replace-with-personal-password
# MAIL_IMAP_PERSONAL_PORT=993
# MAIL_IMAP_PERSONAL_SECURE=true

# Apple iCloud (App-Specific Password from https://appleid.apple.com/account/manage)
# MAIL_IMAP_ICLOUD_HOST=imap.mail.me.com
# MAIL_IMAP_ICLOUD_PORT=993
# MAIL_IMAP_ICLOUD_USER=you@icloud.com
# MAIL_IMAP_ICLOUD_PASS=replace-with-app-specific-password
# MAIL_IMAP_ICLOUD_SECURE=true
# MAIL_SMTP_ICLOUD_HOST=smtp.mail.me.com
# MAIL_SMTP_ICLOUD_PORT=587
# MAIL_SMTP_ICLOUD_USER=you@icloud.com
# MAIL_SMTP_ICLOUD_PASS=replace-with-app-specific-password
# MAIL_SMTP_ICLOUD_SECURE=starttls

# --- Server-wide settings (defaults shown) ---
# Enable write operations: copy/move/delete/flags
MAIL_IMAP_WRITE_ENABLED=false

# --- Optional: sender address override (per SMTP account) ---
# Set when the SMTP auth username differs from the desired From address
# (e.g. shared/group mailboxes where auth uses a personal account).
# When unset, the From address defaults to MAIL_SMTP_<ID>_USER.
# Validated at startup: must contain exactly one '@', no whitespace, and a
# non-empty local part and domain (e.g. "group@company.com"). Dotless
# internal hostnames like "alerts@intranet" are accepted.
# MAIL_SMTP_WORK_FROM_EMAIL=group@company.com

# Timeouts (milliseconds)
MAIL_IMAP_CONNECT_TIMEOUT_MS=30000
MAIL_IMAP_GREETING_TIMEOUT_MS=15000
MAIL_IMAP_SOCKET_TIMEOUT_MS=300000

# Cursor pagination
MAIL_IMAP_CURSOR_TTL_SECONDS=600
MAIL_IMAP_CURSOR_MAX_ENTRIES=512

# Mailbox listing cap for imap_list_mailboxes (default 200, max 10000)
# MAIL_IMAP_MAX_MAILBOXES=1000

# Parallel IMAP connections for imap_search_all_mailboxes (default 4, max 8)
# MAIL_IMAP_SEARCH_CONCURRENCY=8

# Outbound attachments: confine send-tool `file_path` attachments to this
# directory (must exist; `..` and symlinks escaping it are rejected).
# Unset = any readable file may be attached.
# MAIL_ATTACHMENT_UPLOAD_DIR=/path/to/outbox

# Transport: stdio (default) or http (MCP streamable HTTP, stateless).
# The HTTP endpoint has no authentication — keep it on loopback unless only
# an authenticating gateway can reach it.
# MAIL_MCP_TRANSPORT=http
# MAIL_MCP_HTTP_HOST=127.0.0.1
# MAIL_MCP_HTTP_PORT=8000
# MAIL_MCP_HTTP_PATH=/mcp
